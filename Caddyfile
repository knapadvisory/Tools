# In-container config: plain HTTP on :80. TLS is terminated by the shared
# front Caddy on the VPS, which reverse-proxies tools.<domain> to this container.
:80 {
	root * /srv
	encode gzip
	file_server

	# .bat / .mjs must download, not render as text in the browser.
	@dist path /downloads/*.bat /downloads/*.mjs
	header @dist Content-Disposition attachment

	# Tool files get replaced in-place on redeploys — never cache stale copies.
	header Cache-Control "no-cache"
}
